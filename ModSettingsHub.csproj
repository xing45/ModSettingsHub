<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ModSettingsHub</AssemblyName>
    <RootNamespace>ModSettingsHub</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 优先级：命令行 -p:GameDir=... > 环境变量 GOGH_DIR > 下面的默认路径 -->
    <GameDir Condition="'$(GameDir)' == '' and '$(GOGH_DIR)' != ''">$(GOGH_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">D:\steam\steamapps\common\gogh Focus with Your Avatar</GameDir>
    <MelonLoaderDir>$(GameDir)\MelonLoader\net6</MelonLoaderDir>
    <Il2CppDir>$(GameDir)\MelonLoader\Il2CppAssemblies</Il2CppDir>
    <!-- Api 与主项目同仓库：默认指向本仓库的 Api 输出，可用 -p:ApiDir=... 覆盖 -->
    <ApiDir Condition="'$(ApiDir)' == ''">$(MSBuildThisFileDirectory)Api\bin\$(Configuration)\net6.0</ApiDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Api 是独立程序集：不能把它的源码再编进主程序集，否则静态注册表会分裂 -->
    <Compile Remove="Api\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDir)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderDir)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ModSettingsHub.Api">
      <HintPath>$(ApiDir)\ModSettingsHub.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Unity.Addressables">
      <HintPath>$(Il2CppDir)\Unity.Addressables.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.ResourceManager">
      <HintPath>$(Il2CppDir)\Unity.ResourceManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(Il2CppDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(Il2CppDir)\Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(Il2CppDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Il2CppDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(Il2CppDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(Il2CppDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(Il2CppDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(Il2CppDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(Il2CppDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(Il2CppDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 游戏自身的 IL2CPP 程序集：用于强类型访问原生设置页/侧边按钮 -->
  <ItemGroup>
    <Reference Include="Il2CppViewAssemblyDefinition">
      <HintPath>$(Il2CppDir)\Il2CppViewAssemblyDefinition.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppBehaviourAssemblyDefinition">
      <HintPath>$(Il2CppDir)\Il2CppBehaviourAssemblyDefinition.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppDomainAssemblyDefinition">
      <HintPath>$(Il2CppDir)\Il2CppDomainAssemblyDefinition.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInstallerAssemblyDefinition">
      <HintPath>$(Il2CppDir)\Il2CppInstallerAssemblyDefinition.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppR3">
      <HintPath>$(Il2CppDir)\Il2CppR3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppZenject">
      <HintPath>$(Il2CppDir)\Il2CppZenject.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityProcessManager">
      <HintPath>$(Il2CppDir)\UnityProcessManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppRotaryHeart.SerializableDictionaryLite">
      <HintPath>$(Il2CppDir)\Il2CppRotaryHeart.SerializableDictionaryLite.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Localization">
      <HintPath>$(Il2CppDir)\Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sprites\*.png" />
  </ItemGroup>

</Project>
